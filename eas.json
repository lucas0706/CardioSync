{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "CARDIOSYNC_ROUTER_ROOT": "app"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "beta",
      "env": {
        "CARDIOSYNC_ROUTER_ROOT": "app-production"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "CARDIOSYNC_ROUTER_ROOT": "app-production"
      }
    },
    "production-apk": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "CARDIOSYNC_ROUTER_ROOT": "app-production"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
