<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardiosync_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cardiosync_widget_background"
    android:clickable="true"
    android:contentDescription="@string/app_name"
    android:focusable="true"
    android:padding="8dp">

    <ImageView
        android:id="@+id/cardiosync_widget_logo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/cardiosync_widget_plus"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/cardiosync_widget_plus_background"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:textStyle="normal" />

</FrameLayout>
